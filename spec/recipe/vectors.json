{
  "note": "The Hall's arithmetic, shared by the Go implementation and the Rust program. Amounts are integer atoms as strings at the stated scale; shares are plain integers. Times are seconds from the start of each scenario. Regenerate with go test ./internal/basket -update. A vector is never edited to make an implementation pass.",
  "vest_window_seconds": 3600,
  "scenarios": [
    {
      "name": "donation vests over the window",
      "purpose": "A donated surplus becomes pending and enters the ledger linearly, so share value cannot jump in one block.",
      "scale": 6,
      "steps": [
        {
          "op": "initial",
          "ledger": "1000000",
          "pending": "0",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "actual": "2000000",
          "kind": "credit",
          "ledger": "1000000",
          "pending": "1000000",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "at_seconds": 900,
          "actual": "2000000",
          "kind": "unchanged",
          "ledger": "1250000",
          "pending": "750000",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "at_seconds": 1800,
          "actual": "2000000",
          "kind": "unchanged",
          "ledger": "1500000",
          "pending": "500000",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "at_seconds": 3600,
          "actual": "2000000",
          "kind": "unchanged",
          "ledger": "2000000",
          "pending": "0",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "at_seconds": 7200,
          "actual": "2000000",
          "kind": "unchanged",
          "ledger": "2000000",
          "pending": "0",
          "unclaimed": "0",
          "supply": "1000"
        }
      ]
    },
    {
