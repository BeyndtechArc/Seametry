    {
      "name": "multiplier only issuer",
      "purpose": "A Scaled UI multiplier change moves no raw units, so sync finds nothing. This is the xStocks case and the common one.",
      "scale": 6,
      "steps": [
        {
          "op": "initial",
          "ledger": "1000000",
          "pending": "0",
          "unclaimed": "0",
          "supply": "1000"
        },
        {
          "op": "sync",
          "at_seconds": 2592000,
