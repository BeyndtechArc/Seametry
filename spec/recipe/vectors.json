    {
      "name": "seizure larger than pending",
      "purpose": "A loss consumes unvested pending first, then falls on ledger and unclaimed in proportion, so neither group absorbs it alone.",
      "scale": 6,
      "steps": [
        {
          "op": "initial",
          "ledger": "600000",
          "pending": "0",
          "unclaimed": "400000",
          "supply": "1000"
