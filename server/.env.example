# Seametry reads everything it can permissionlessly. These two are the only
# credentials the phase 0 and phase 1 pipeline needs, and both buy throughput
# rather than access: the same data is reachable without them, more slowly.

# Solana RPC. A paid endpoint matters because the observation loop reads mint
# accounts and oracle accounts on a cadence, and the public endpoint is shared
# and rate limited. Any provider satisfies this; the URL carries its own key.
HELIUS_RPC_URL=

# Jupiter. The free lite endpoint returns identical quotes; the key raises the
# rate limit. Verified 23 September 2026: lite and keyed responses matched
# exactly for the same query.
JUP_KEY=

# Oracles are read from chain, not from credentialed APIs. Pyth and Stork both
# publish feed accounts on Solana that anyone can read with an RPC connection
# and nothing else, which is why neither appears here. See
# docs/decisions/2026-09-23-oracles-on-chain.md.
#
# Chainlink Data Streams is the exception: it is a credentialed, paid,
# subscription product with no free tier. It is out of scope until there is a
# reason to pay for it, and its absence costs nothing that matters.
