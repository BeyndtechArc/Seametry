# Copy this file to server/deploy/.env on the host. The real .env is ignored
# by Git. Generate the database password as URL-safe hexadecimal, for example:
# openssl rand -hex 32
SEAMETRY_POSTGRES_PASSWORD=replace-with-64-hex-characters

# Better Auth uses the same private PostgreSQL container but a separate
# database and least-privilege login. Keep both passwords distinct.
SEAMETRY_AUTH_POSTGRES_PASSWORD=replace-with-another-64-hex-value

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

# This remains the first-party web origin because Vercel forwards /api/auth
# and /api/account to this private authority.
BETTER_AUTH_URL=https://seametry.xyz
SEAMETRY_APP_ORIGINS=https://www.seametry.xyz,https://seametry.xyz,http://localhost:3000

# Server-only Google OAuth and Better Auth Infrastructure credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
BETTER_AUTH_API_KEY=replace-with-better-auth-infrastructure-key

# Local proof uses http://localhost. On Oracle, set the public HTTPS hostname,
# with no path, after its DNS A record points to the VM.
SEAMETRY_API_ORIGIN=https://api.example.com

# The Hall is on devnet. A dedicated provider endpoint is optional; the public
# endpoint is the fallback and has a shared rate limit.
SEAMETRY_HALL_DEVNET_RPC_URL=https://api.devnet.solana.com

# These buy provider throughput. They stay server-side and never use NEXT_PUBLIC_.
HELIUS_RPC_URL=
JUP_KEY=
