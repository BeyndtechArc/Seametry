# Copy this file to .env.local for local development. Never commit .env.local.
# In Vercel, add the same values under Project Settings > Environment Variables.

# Deployed Seametry Gateway root. Required for live Terminal data.
# Example: https://api.seametry.example
SEAMETRY_API_URL=

# Better Auth authority root. This is non-secret routing configuration for the
# server-side Next proxy; Google credentials and Better Auth keys stay on the
# Oracle service. Example: https://api.seametry.example
SEAMETRY_AUTH_ORIGIN=

# Activity record and feedback: the same value as SEAMETRY_ACTIVITY_INGEST_SECRET
# in server/deploy/.env on the Gateway host. Unset, trades are not recorded and
# feedback cannot be sent. Generate once and use it on both sides:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTIVITY_INGEST_SECRET=

# Allocation execution. These are server-only and must never use NEXT_PUBLIC_.
JUPITER_API_KEY=
MAINNET_RPC_URL=

# Oracle-free basket chart observations. Uses read-only Jupiter quotes at a
# fixed 25 USDC per admitted instrument, once per UTC day.
# Configure a Redis REST store (e.g. free Upstash), never expose these client-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel calls GET /api/market/observe with Authorization: Bearer CRON_SECRET.
# If unset, the sampler refuses requests. Generate a random secret.
CRON_SECRET=

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ALLOCATION_APPROVAL_SECRET=

# The mainnet wallet whose USDC account receives Seametry routing fees.
# The exact rate comes from the versioned fee schedule in allocation/rules.ts.
# Its USDC account must already be open; Allocation is unavailable
# until this is set, and refuses every leg while the account is missing.
ALLOCATION_FEE_WALLET=

# Comma-separated ISO 3166-1 alpha-2 country codes excluded by the issuers'
# actual eligibility terms. There is no safe universal default. If this is
# empty or unset, allocation fails closed and nothing can be purchased.
# Example syntax only: AA,BB
ALLOCATION_BLOCKED_COUNTRIES=

# Local development only. Vercel supplies x-vercel-ip-country in deployments.
# Use one ISO 3166-1 alpha-2 code to exercise the country gate locally.
ALLOCATION_ASSUME_COUNTRY=

# Hall devnet demo. The public Solana endpoint is the application's default,
# so NEXT_PUBLIC_HALL_DEMO_RPC can remain empty unless a different devnet RPC
# is intentionally exposed to browsers.
NEXT_PUBLIC_HALL_DEMO_RPC=https://api.devnet.solana.com

# Hall mutation routes only. See clients/web/README.md for key generation and
# funding. Both values are server-only secrets.
HALL_DEMO_FUNDER_SECRET_KEY=
HALL_DEMO_ISSUER_SEED=
