{
  "name": "seametry",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "clients/web",
    "clients/packages/*"
  ],
  "scripts": {
    "spec": "node shared/tools/spec/generate.mjs",
    "spec:check": "node shared/tools/spec/generate.mjs --check",
    "verify:receipts": "node shared/tools/spec/verify-receipts.mjs",
    "explorer": "go run ./server/cmd/explorer",
    "survey": "go run ./server/cmd/survey",
    "serve": "node shared/tools/serve.mjs",
    "tokens": "node .claude/skills/seametry-design/scripts/build-tokens.mjs .claude/skills/seametry-design/assets/tokens/seametry.tokens.json clients/packages/ui/src/generated",
    "design:lint": "node .claude/skills/seametry-design/scripts/design-lint.mjs server/cmd/explorer clients/packages/ui clients/web",
    "design:test": "node --test shared/tools/design/lint_test.mjs shared/tools/design/ligatures_test.mjs shared/tools/design/build_note_test.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
