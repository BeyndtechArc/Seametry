{
  "name": "seametry",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w @seametry/mobile",
    "dev:web": "npm run dev -w @seametry/web",
    "dev:api": "npm run dev -w @seametry/api",
    "build:mobile": "cd apps/mobile && npx expo export --platform android --output-dir ../../dist/mobile-android --clear",
    "spec": "node tools/spec/generate.mjs",
    "spec:check": "node tools/spec/generate.mjs --check",
    "coverage": "node --experimental-strip-types tools/coverage-probe.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @seametry/web && npm run build -w @seametry/api",
    "verify:receipts": "node tools/spec/verify-receipts.mjs",
    "explorer": "go run ./tools/explorer",
    "survey": "go run ./tools/survey",
    "fonts": "go run ./tools/fonts",
    "serve": "node tools/serve.mjs",
    "tokens": "node .claude/skills/seametry-design/scripts/build-tokens.mjs .claude/skills/seametry-design/assets/tokens/seametry.tokens.json packages/ui/src/generated",
    "design:lint": "node .claude/skills/seametry-design/scripts/design-lint.mjs tools/explorer packages/ui",
    "design:test": "node --test tools/design/lint_test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
